# Force Unix line endings for shell build scripts on all platforms
*.sh text eol=lf
*.conf text eol=lf
*.inc text eol=lf
build.sh text eol=lf
.gitignore text eol=lf
Dockerfile text eol=lf
# no .sh suffix; CRLF would make run-parts fail the shebang
external/packages/bsp/common/etc/initramfs/post-update.d/99-uboot text eol=lf
external/config/kernel/*.config text eol=lf
