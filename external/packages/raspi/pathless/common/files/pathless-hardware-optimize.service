# Pathless hardware optimization service
# Apply optimisations
# This service may block the boot process for up to 2 minutes

[Unit]
Description=Pathless hardware optimization
Before=basic.target
After=sysinit.target local-fs.target pathless-hardware-monitor.target
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/lib/pathless/pathless-hardware-optimization start
ExecStop=/usr/lib/pathless/pathless-hardware-optimization stop
RemainAfterExit=yes
TimeoutStartSec=2min

[Install]
WantedBy=basic.target
